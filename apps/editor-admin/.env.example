# editor-admin configuration — copy to .env and fill in.
# Secrets live here, on the server, once. They never reach the browser.

# Postgres connection string — its OWN database, not editor-server's `acip`.
# Port 5434 is the one `docker compose up -d` in this folder publishes; 5432
# and 5433 are already spoken for by other databases on a typical dev box.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/editor_admin?schema=public"

# Signs the session cookie. Any long random string; rotating it logs everyone out.
# Generate one with: openssl rand -base64 32
AUTH_SECRET=""
