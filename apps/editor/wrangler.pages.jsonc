{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acip-editor",
  "compatibility_date": "2026-08-05",

  // Pages config lives in its own file on purpose: Workers-only keys such as
  // `main` and `assets` do not apply to a Pages project, so the two targets
  // cannot share one wrangler file.
  //
  //   npx wrangler pages deploy --config wrangler.pages.jsonc
  //
  // SPA fallback for Pages comes from public/_redirects, not this file.
  "pages_build_output_dir": "./dist"
}
