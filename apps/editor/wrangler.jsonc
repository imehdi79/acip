{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "acip-editor",
  "compatibility_date": "2026-08-05",

  // Assets-only Worker: there is no server code, so `main` is omitted.
  // `directory` is relative to this file, and matches vite's build.outDir.
  "assets": {
    "directory": "./dist",
    // Client-routed SPA: unmatched paths serve index.html with a 200 rather
    // than a 404, so a deep link or a reload does not break.
    "not_found_handling": "single-page-application"
  },

  "observability": {
    "enabled": true
  }
}
